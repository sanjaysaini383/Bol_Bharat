# Copy this file to .env and fill in the two keys below.
# .env is listed in .gitignore. Never commit it.

# --- Required -------------------------------------------------------------
# Gnani API Platform key (Prisma v3.0 STT + Timbre v3.0 TTS).
GNANI_API_KEY=

# --- Recommended (free) ---------------------------------------------------
# Any OpenAI-compatible chat endpoint. The default is Groq's free tier:
# create a key at https://console.groq.com/keys
# Without a key the agent still works for Hindi / Hinglish / English through
# the rule-based parser; other languages need the LLM.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- Optional -------------------------------------------------------------
# 32-byte key, base64. Encrypts names and transcripts at rest.
# Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# If empty, a key is generated once and stored in data/khata.key.
KHATA_ENC_KEY=

# Shop name used in reminder messages.
SHOP_NAME=Kirana Store

# If set, the app and API require ?k=<token> in the URL (use on hosted demos).
ACCESS_TOKEN=

# Speech settings
GNANI_TTS_VOICE=Avinash
GNANI_TTS_SPEED=1.05
GNANI_STT_FORMAT=transcribe
GNANI_VAD_THRESHOLD=0.75
GNANI_MIN_SILENCE_MS=350

# Default reply language before the user has spoken (hi, en, kn, ta, te, mr, bn, gu, pa, ml)
DEFAULT_LANG=hi

# Amounts at or above this are confirmed by voice before saving.
BIG_AMOUNT=20000

# Encrypted transcripts are deleted after this many hours.
TRANSCRIPT_RETENTION_HOURS=72

# Load synthetic demo customers when the ledger is empty (1 or 0).
DEMO_SEED=1

HOST=0.0.0.0
PORT=8000
